# Replace pw with your Supabase database password, and fill in your project region.
DATABASE_URL="postgresql://postgres:pw@aws-0-[REGION].pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Copy BOTH keys from the SAME Clerk development instance at dashboard.clerk.com.
# Electron runs on localhost; pk_live_/sk_live_ cannot authenticate there.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Live / shared tabs (LiveKit SFU). Dev: `livekit-server --dev` -> ws://127.0.0.1:7880, devkey / secret
LIVEKIT_URL="ws://127.0.0.1:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Realtime: socket-server.cjs loads the same .env.local via @next/env.
# For non-default frontend origins or packaged random ports, list their exact origin.
CUBICS_SOCKET_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Optional: pin Clerk issuer or provide its PEM public JWT key for offline verification.
# CLERK_ISSUER="https://your-instance.clerk.accounts.dev"
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
