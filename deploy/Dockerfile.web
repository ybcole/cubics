# Hosted Cubics Next.js/API service. This image never enters Electron.
FROM node:22-bookworm-slim AS deps
WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

FROM deps AS build
WORKDIR /work
COPY . .
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SOCKET_URL
ARG NEXT_PUBLIC_CUBICS_HOSTED_API_ENABLED=false
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY}
ENV NEXT_PUBLIC_SOCKET_URL=${NEXT_PUBLIC_SOCKET_URL}
ENV NEXT_PUBLIC_CUBICS_HOSTED_API_ENABLED=${NEXT_PUBLIC_CUBICS_HOSTED_API_ENABLED}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
RUN test -n "$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY" && test -n "$NEXT_PUBLIC_SOCKET_URL"
# Build uses an inert test string only; production signing key is runtime-only.
RUN npx prisma generate && CLERK_SECRET_KEY=sk_test_ci_build_only_inert npm run build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /srv
COPY --from=build --chown=node:node /work/.next/standalone ./
COPY --from=build --chown=node:node /work/.next/static ./.next/static
COPY --from=build --chown=node:node /work/public ./public
USER node
EXPOSE 3000
CMD ["node","server.js"]
