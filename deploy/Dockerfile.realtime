# Authenticated Socket.IO service. No Prisma/database credentials here.
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production SOCKET_PORT=3001
WORKDIR /srv
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY socket-server.cjs ./
COPY src/lib/security/realtime-identity.cjs src/lib/security/realtime-membership.cjs src/lib/security/realtime-room-policy.cjs ./src/lib/security/
USER node
EXPOSE 3001
CMD ["node", "socket-server.cjs"]
