{
  "name": "custom-room-canvas",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "app:dev": "concurrently -k -s first \"next dev\" \"node socket-server.cjs\" \"wait-on tcp:127.0.0.1:3000 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "app:start": "npm run build && node scripts/prepare-standalone.js && electron .",
    "app:dist": "npm run build && node scripts/prepare-standalone.js && electron-builder --mac",
    "brand:check": "node scripts/check-brand.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.0.0",
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^5.10.0",
    "@types/react-grid-layout": "^1.3.5",
    "clsx": "^2.1.0",
    "lucide-react": "^0.326.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.4.4",
    "react-hook-form": "^7.49.3",
    "react-rnd": "^10.3.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.7.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^4.4.16"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.39",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.4",
    "wait-on": "^9.1.0"
  }
}
